# Пример настроек. Скопируйте в .env и при желании поменяйте пароль:
#   cp .env.example .env        (Windows: copy .env.example .env)
# Настоящий .env в git не попадает (он в .gitignore).

POSTGRES_DB=gruzopoisk
POSTGRES_USER=gruzopoisk
POSTGRES_PASSWORD=gruzopoisk

# Порт на вашем компьютере, на котором откроется сайт
APP_PORT=8080
